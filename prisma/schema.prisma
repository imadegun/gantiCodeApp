// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Purchase Order model for production management
model PurchaseOrder {
  id           String   @id @default(cuid())
  poNo         String   @unique
  clientId     String // References DesignCode from MySQL
  deliveryDate DateTime
  qtyOrdered   Int
  status       POStatus @default(draft)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("purchase_orders")
}

// Stock tracking by ClientCode
model StockByClientCode {
  id                String      @id @default(cuid())
  clientCode        String      @unique
  quantityAvailable Int         @default(0)
  quantityReserved  Int         @default(0)
  status            StockStatus @default(available)
  lastUpdated       DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("stock_by_client_code")
}

// Stock tracking by DesignCode
model StockByDesignCode {
  id                String      @id @default(cuid())
  designCode        String      @unique
  totalQuantity     Int         @default(0)
  availableQuantity Int         @default(0)
  reservedQuantity  Int         @default(0)
  status            StockStatus @default(available)
  lastUpdated       DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("stock_by_design_code")
}

// Enums
enum POStatus {
  draft
  confirmed
  in_production
  completed
  cancelled
}

enum StockStatus {
  available
  low_stock
  out_of_stock
}

// User Authentication System
model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String    @unique
  password  String
  name      String?
  role      UserRole  @default(USER)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  stockEntries StockEntry[]
  stockOffers  StockOffer[]

  @@map("users")
}

// Enhanced Stock Management
model StockEntry {
  id                   String      @id @default(cuid())
  clientCode           String
  designCode           String
  productId            Int // References MySQL tblcollect_master.ID
  department           String?
  region               String?
  quantityIn           Int
  isStockInSetComplete Boolean     @default(false)
  isLid                Boolean     @default(false)
  isBody               Boolean     @default(false)
  status               StockStatus @default(available)
  notes                String?
  expirationYears      Int         @default(2) // 2, 5, or 10 years
  expirationDate       DateTime? // Calculated based on expirationYears
  createdBy            String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  creator User         @relation(fields: [createdBy], references: [id])
  offers  StockOffer[]

  @@map("stock_entries")
}

model StockOffer {
  id           String      @id @default(cuid())
  stockEntryId String
  clientId     String // Client being offered to
  quantity     Int
  status       OfferStatus @default(pending)
  offerDate    DateTime    @default(now())
  expiryDate   DateTime // When offer expires
  notes        String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  stockEntry StockEntry @relation(fields: [stockEntryId], references: [id])
  creator    User       @relation(fields: [createdBy], references: [id])

  @@map("stock_offers")
}

model Client {
  id         String   @id @default(cuid())
  clientCode String   @unique
  name       String
  email      String?
  phone      String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("clients")
}

// Enums
enum UserRole {
  ADMIN
  STOCK_MANAGER
  PRODUCT_CODE_MANAGER
  USER
}

enum OfferStatus {
  pending
  approved
  rejected
  expired
  cancelled
}

model Stock {
  id String @id @default(cuid())

  // -- Product Properties (Mirrored from MySQL Collections) --
  designCode   String
  clientCode   String
  nameCode     String?
  photo1       String?
  categoryCode String?
  colorCode    String?
  textureCode  String?
  sizeCode     String?
  materialCode String?

  // -- Internal Stock Fields --
  department String?
  region     String?

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)

  status StockStatus @default(available)
  notes  String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Indexes for faster lookup
  @@index([designCode])
  @@index([clientCode])
  @@map("stocks")
}
